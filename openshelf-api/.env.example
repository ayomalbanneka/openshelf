# Environment variables for OpenShelf API
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database configuration
DATABASE_URL="postgresql://postgres:<your_passsword>@localhost:5433/openshelf_db"

# Seed data passwords
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

WEB_URL=https://yourdomain.com

# JWT configuration
JWT_SECRET=your_jwt_access_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# MinIO configuration
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=openshelf
STORAGE_REGION=ap-southeast-1
STORAGE_PUBLIC_URL=http://localhost:9000/openshelf

# Meilisearch configuration
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=changeme_master_key

# Resend configuration
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com
APP_URL=http://localhost:3000

# Alert thresholds
ALERT_ERROR_RATE_PCT=5
ALERT_P95_MS=2000
ALERT_MEMORY_PCT=85
ALERT_DB_LATENCY_MS=500
ALERT_COOLDOWN_MINUTES=30
ALERT_RECIPIENT_EMAILS=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
API_URL=http://localhost:4000

#stripe
STRIPE_SECRET_KEY=
STRIPE_SUPPORTER_PRICE_ID=
STRIPE_PATRON_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

#Redis
REDIS_URL=redis://localhost:6379