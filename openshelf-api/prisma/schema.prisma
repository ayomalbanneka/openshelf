generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  role               Role                @default(USER)
  avatarUrl          String?
  bio                String?
  country            String?
  preferredLanguage  String              @default("en")
  isActive           Boolean             @default(true)
  isEmailVerified    Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  website            String?
  bookmarks          Bookmark[]
  discussions        ClubDiscussion[]
  clubMemberships    ClubMember[]
  clubsCreated       Club[]
  comments           Comment[]
  readingLists       ReadingList[]
  readingProgress    ReadingProgress[]
  uploads            Resource[]
  reviews            Review[]
  submissions        Submission[]
  following          UserFollow[]        @relation("Follower")
  followers          UserFollow[]        @relation("Following")
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  sentInvites        StaffInvite[]
  refreshTokens      RefreshToken[]
  reports            Report[]             @relation("UserReports")

  @@index([email])
  @@map("users")
}

model EmailVerification {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      EmailVerificationType @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId])
  @@index([userId, type])
  @@map("email_verifications")
}

enum EmailVerificationType {
  EMAIL_VERIFICATION
  ADMIN_2FA
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String // 6-digit code
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([code])
  @@map("password_resets")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model StaffInvite {
  id          String    @id @default(cuid())
  email       String
  role        Role
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([tokenHash])
  @@map("staff_invites")
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("user_follows")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  coverUrl    String?
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  resources   Resource[]

  @@index([slug])
  @@map("categories")
}

model Resource {
  id               String                   @id @default(cuid())
  title            String
  slug             String                   @unique
  description      String?
  type             ResourceType
  language         String                   @default("en")
  fileUrl          String
  fileSize         Int?
  mimeType         String?
  thumbnailUrl     String?
  duration         Int?
  pageCount        Int?
  isPublished      Boolean                  @default(false)
  publishedAt      DateTime?
  author           String?
  publisher        String?
  isbn             String?
  edition          String?
  publicationYear  Int?
  viewCount        Int                      @default(0)
  downloadCount    Int                      @default(0)
  uploadedById     String
  categoryId       String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  search_vector    Unsupported("tsvector")? @default(dbgenerated("(((setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(author, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'C'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(publisher, ''::text)), 'D'::\"char\"))"))
  bookmarks        Bookmark[]
  clubDiscussions  ClubDiscussion[]
  comments         Comment[]
  examPaper        ExamPaper?
  lessons          Lesson[]
  readingListItems ReadingListItem[]
  readingProgress  ReadingProgress[]
  tags             ResourceTag[]
  category         Category                 @relation(fields: [categoryId], references: [id])
  uploadedBy       User                     @relation(fields: [uploadedById], references: [id])
  reviews          Review[]
  reports          Report[]

  @@index([slug])
  @@index([type])
  @@index([categoryId])
  @@index([uploadedById])
  @@index([isPublished])
  @@index([language])
  @@index([search_vector], type: Gin)
  @@map("resources")
}

model Lesson {
  id         String   @id @default(cuid())
  title      String
  sortOrder  Int      @default(0)
  duration   String?
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  resourceId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("lessons")
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  resources ResourceTag[]

  @@index([slug])
  @@map("tags")
}

model ResourceTag {
  resourceId String
  tagId      String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  @@map("resource_tags")
}

model ExamPaper {
  id            String       @id @default(cuid())
  resourceId    String       @unique
  subject       String
  year          Int
  grade         String?
  institution   String?
  semester      String?
  examType      ExamType     @default(PAST_PAPER)
  markSchemeUrl String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  resource      Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  submissions   Submission[]

  @@index([subject])
  @@index([year])
  @@map("exam_papers")
}

model Submission {
  id          String           @id @default(cuid())
  userId      String
  examPaperId String
  fileUrl     String
  status      SubmissionStatus @default(PENDING)
  score       Float?
  feedback    String?
  reviewedAt  DateTime?
  submittedAt DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  examPaper   ExamPaper        @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, examPaperId])
  @@index([status])
  @@map("submissions")
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([resourceId])
  @@map("reviews")
}

model ReadingProgress {
  id          String   @id @default(cuid())
  userId      String
  resourceId  String
  currentPage Int      @default(0)
  totalPages  Int?
  percentage  Float    @default(0)
  isCompleted Boolean  @default(false)
  lastReadAt  DateTime @default(now())
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
  @@map("reading_progress")
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
  @@map("bookmarks")
}

model ReadingList {
  id          String            @id @default(cuid())
  title       String
  description String?
  isPublic    Boolean           @default(true)
  coverUrl    String?
  userId      String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       ReadingListItem[]
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault   Boolean           @default(false)

  @@index([userId])
  @@index([isPublic])
  @@map("reading_lists")
}

model ReadingListItem {
  id         String      @id @default(cuid())
  sortOrder  Int         @default(0)
  note       String?
  listId     String
  resourceId String
  addedAt    DateTime    @default(now())
  list       ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  resource   Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([listId, resourceId])
  @@index([listId])
  @@map("reading_list_items")
}

model Club {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  coverUrl    String?
  isPublic    Boolean          @default(true)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  discussions ClubDiscussion[]
  members     ClubMember[]
  createdBy   User             @relation(fields: [createdById], references: [id])

  @@index([slug])
  @@index([isPublic])
  @@map("clubs")
}

model ClubMember {
  clubId   String
  userId   String
  role     ClubRole @default(MEMBER)
  joinedAt DateTime @default(now())
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([clubId])
  @@map("club_members")
}

model ClubDiscussion {
  id         String    @id @default(cuid())
  title      String
  body       String
  clubId     String
  resourceId String?
  authorId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  author     User      @relation(fields: [authorId], references: [id])
  club       Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  resource   Resource? @relation(fields: [resourceId], references: [id])
  comments   Comment[]

  @@index([clubId])
  @@index([resourceId])
  @@map("club_discussions")
}

model Comment {
  id           String          @id @default(cuid())
  body         String
  authorId     String
  resourceId   String?
  discussionId String?
  parentId     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  discussion   ClubDiscussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parent       Comment?        @relation("CommentThread", fields: [parentId], references: [id])
  replies      Comment[]       @relation("CommentThread")
  resource     Resource?       @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([discussionId])
  @@index([parentId])
  @@map("comments")
}

model Report {
  id           String       @id @default(cuid())
  resourceId   String
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reportedById String
  reportedBy   User         @relation("UserReports", fields: [reportedById], references: [id], onDelete: Cascade)
  reason       ReportReason
  details      String?
  status       ReportStatus @default(OPEN)
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@unique([resourceId, reportedById]) // one report per user per resource
  @@index([resourceId])
  @@index([status])
  @@map("reports")
}

enum ReportReason {
  SPAM
  COPYRIGHT
  INAPPROPRIATE
  MISINFORMATION
  BROKEN_FILE
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum ResourceType {
  BOOK
  COURSE
  EXAM_PAPER
  DOCUMENT
  AUDIO
}

enum ExamType {
  PAST_PAPER
  MODEL_PAPER
  ASSIGNMENT
  QUIZ
}

enum SubmissionStatus {
  PENDING
  REVIEWED
  PASSED
  FAILED
}

enum ClubRole {
  OWNER
  MODERATOR
  MEMBER
}
